# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Supabase Backend Configuration (Server-side)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Supabase Client Configuration (Vite client-side)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Live SMS Providers (Optional: Twilio or Fast2SMS for cellular SMS dispatch)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FAST2SMS_API_KEY=

# Maps API (Optional: Google Places API key, defaults to live Overpass OSM)
MAPS_API_KEY=

# Firebase Client Configuration (Vite client-side)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
